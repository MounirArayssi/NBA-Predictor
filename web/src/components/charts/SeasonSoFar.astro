---
// The current season so far: running share of winners picked, by date, against
// the always-pick-the-home-team baseline, plus the season's headline figures.
import fs from "node:fs";
import path from "node:path";
import { performance } from "../../lib/data.js";

interface Props { season: string }
const { season } = Astro.props;
const file = path.resolve(process.cwd(), "public", "data", `archive-${season}.json`);
const rows = (fs.existsSync(file) ? JSON.parse(fs.readFileSync(file, "utf8")) : [])
  .sort((a, b) => a.d.localeCompare(b.d) || a.id.localeCompare(b.id));
const S = performance.record.seasons.find((s) => s.season === season)?.all;

const MIN_N = 10; // lines start once there are this many games
function running(okFn) {
  const out = [];
  let n = 0, k = 0;
  rows.forEach((r, i) => {
    n++; if (okFn(r)) k++;
    if (n >= MIN_N && (i === rows.length - 1 || rows[i + 1].d !== r.d)) out.push({ d: r.d, v: (100 * k) / n, n });
  });
  return out;
}
const sFc = running((r) => r.ok);
const sHome = running((r) => r.hs > r.as_);

const days = (d) => Date.parse(d + "T12:00:00Z") / 864e5;
const d0 = rows.length ? days(rows[0].d) : 0, d1 = rows.length ? days(rows.at(-1).d) : 1;
const W = 760, H = 300, m = { l: 44, r: 130, t: 16, b: 36 };
const lo = 40, hi = 100;
const x = (d) => m.l + (W - m.l - m.r) * ((days(d) - d0) / Math.max(1, d1 - d0));
const y = (v) => m.t + (H - m.t - m.b) * (1 - (Math.min(hi, Math.max(lo, v)) - lo) / (hi - lo));
const pathOf = (s) => s.map((p, i) => `${i ? "L" : "M"}${x(p.d).toFixed(1)},${y(p.v).toFixed(1)}`).join(" ");
const fmt = (d) => new Date(d + "T12:00:00Z").toLocaleDateString("en-US", { timeZone: "UTC", month: "short", day: "numeric" });
const xt = rows.length ? [rows[0].d, rows[Math.floor(rows.length / 2)].d, rows.at(-1).d].filter((v, i, a) => a.indexOf(v) === i) : [];
const last = (s) => s.at(-1);
const series = [
  { s: sFc, cls: "fc", label: "Model" },
  { s: sHome, cls: "home", label: "Home team" },
].filter((r) => r.s.length);
const placed = series.map((r) => ({ r, ly: y(last(r.s).v) + 4 })).sort((a, b) => a.ly - b.ly);
placed.forEach((p, i) => { if (i && p.ly - placed[i - 1].ly < 16) p.ly = placed[i - 1].ly + 16; });
placed.forEach((p) => (p.r.ly = p.ly));
// Last 10 graded games, newest last, for the strip beside the chart.
const recent = rows.slice(-10);
---
{rows.length === 0 ? <p class="state">No {season} games have been graded yet.</p> : (
<div class="sofar" data-reveal>
  <figure class="chart">
    <div class="chart-scroll">
      <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-labelledby="sf-t">
        <title id="sf-t">{season}: running share of winners picked by date, {last(sFc)?.v.toFixed(1)}% after {rows.length} games; the home team won {last(sHome)?.v.toFixed(1)}%.</title>
        {[40, 50, 60, 70, 80, 90, 100].map((v) => (<g><line class="grid" x1={m.l} x2={W - m.r} y1={y(v)} y2={y(v)} /><text x={m.l - 8} y={y(v) + 4} text-anchor="end">{v}%</text></g>))}
        {xt.map((d) => <text x={x(d)} y={H - m.b + 18} text-anchor="middle">{fmt(d)}</text>)}
        {series.map((r) => (
          <g class={`ser ${r.cls}`}>
            <path d={pathOf(r.s)} />
            <circle class="end" cx={x(last(r.s).d)} cy={y(last(r.s).v)} r="4.5" />
            <text x={x(last(r.s).d) + 10} y={r.ly} class="lab">{`${r.label} ${last(r.s).v.toFixed(1)}%`}</text>
          </g>
        ))}
      </svg>
    </div>
    <figcaption>Share of games so far in which the forecast winner won, against the share won by the home team. Lines start once there are {MIN_N} games; early points move a lot.</figcaption>
  </figure>

  {S && (
    <div class="side">
      <div class="big num">{S.wins}–{S.n - S.wins}</div>
      <div class="sm">{S.n} graded games · {S.win}% winners</div>
      <div class="meter" style={`--k:${S.wins / S.n}`}><span></span></div>
      <dl class="mini">
        <dt>Average margin miss</dt><dd class="num">{S.margin_mae.toFixed(1)} pts</dd>
        <dt>Brier score</dt><dd class="num">{S.brier.toFixed(3)}</dd>
        <dt>Home team won</dt><dd class="num">{S.home_win}%</dd>
      </dl>
      <p class="chart-title">Last {recent.length} games</p>
      <ol class="last10" aria-label={`Last ${recent.length} graded games`}>
        {recent.map((r, i) => (
          <li class={r.ok ? "ok" : "miss"} style={`--i:${i}`} title={`${fmt(r.d)}: ${r.a} at ${r.h}, ${r.as_}–${r.hs}`}>
            <span class="sr-only">{`${fmt(r.d)}, ${r.a} at ${r.h}: ${r.ok ? "correct" : "missed"}`}</span>
          </li>
        ))}
      </ol>
    </div>
  )}
</div>
)}

<style>
  .sofar { display: grid; gap: var(--s6); grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 1000px) { .sofar { grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr); align-items: start; } }
  .ser path { fill: none; stroke-width: 2.25; stroke-linejoin: round; }
  .ser.fc path, .ser.fc .end { stroke: var(--model); } .ser.fc .end { fill: var(--model); }
  .ser.home path { stroke: var(--neutral-mark); stroke-dasharray: 5 4; stroke-width: 1.5; } .ser.home .end { fill: var(--neutral-mark); stroke: none; }
  .ser .lab { font-size: 12px; }
  .ser.fc .lab { fill: var(--model); }
  :global(.chart.in) .ser.fc .end { animation: ping 2.4s ease-out 1.3s infinite; }
  @keyframes ping { 0% { stroke-width: 0; stroke-opacity: 0.6; } 70%, 100% { stroke-width: 14; stroke-opacity: 0; } }
  .side { border-top: 2px solid var(--rule-heavy); padding-top: var(--s3); }
  .big { font-size: 2.4rem; font-weight: 500; line-height: 1.1; }
  .sm { font-size: 0.85rem; color: var(--muted); margin-top: 2px; }
  .meter { height: 6px; background: var(--rule); margin-top: var(--s3); border-radius: 1px; overflow: hidden; }
  .meter span { display: block; height: 100%; width: calc(var(--k) * 100%); background: var(--model); }
  .mini { display: grid; grid-template-columns: 1fr auto; gap: 4px var(--s4); margin: var(--s4) 0; font-size: 0.9rem; }
  .mini dt { color: var(--ink-2); } .mini dd { margin: 0; }
  .last10 { list-style: none; margin: var(--s2) 0 0; padding: 0; display: flex; gap: 6px; }
  .last10 li { width: 22px; height: 22px; border-radius: 50%; }
  .last10 .ok { background: var(--ball-hit); }
  .last10 .miss { background: var(--rule); box-shadow: inset 0 0 0 1px var(--rule-strong); }
  :global(html.js) .meter span { transform: scaleX(0); transform-origin: left; }
  :global(html.js) .sofar.in .meter span { transform: none; transition: transform 1.1s var(--ease-out) 0.2s; }
  :global(html.js) .last10 li { transform: scale(0); }
  :global(html.js) .sofar.in .last10 li { transform: none; transition: transform 0.4s var(--ease-out) calc(0.4s + var(--i) * 70ms); }
  @media (prefers-reduced-motion: reduce) { :global(html.js) .meter span, :global(html.js) .last10 li { transform: none; } }
</style>
