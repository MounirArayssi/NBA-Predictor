---
// One arena-style scoreboard per game: team color bars, LED digits for the
// projected score (or the final, once played), and the win-probability split.
// Each board links to the game page. Colors never carry meaning alone: every
// team is named, and the scores and percentages are written out.
import ProbabilityBar from "../ProbabilityBar.astro";
import { teamByAbbr, gameUrl, fmtTime, favorite } from "../../lib/data.js";
import { teamVars } from "../../lib/teamColors.js";

interface Props { games: any[]; label: string }
const { games, label } = Astro.props;
const nick = (abbr) => {
  const t = teamByAbbr[abbr];
  return t ? t.name.replace(t.city, "").trim() || t.name : abbr;
};
---
<ul class="slateboard" aria-label={label}>
  {games.map((g, i) => {
    const p = g.fc;
    const final = g.status === "final";
    const fav = favorite(p, g);
    const winner = final ? (g.score.h > g.score.a ? g.home : g.away) : null;
    const rows = [["away", g.away, p?.pa, g.score?.a], ["home", g.home, p?.ph, g.score?.h]];
    const big = (proj, fin) => (final ? fin : proj != null ? Math.round(proj) : null);
    const state = final
      ? (p ? { t: `${p.correct ? "✓" : "✗"} Picked ${fav.abbr}`, c: p.correct ? "ok" : "miss" } : { t: "No forecast", c: "na" })
      : p ? null : { t: "Forecast not yet published", c: "na" };
    const aria = `${teamByAbbr[g.away]?.name} at ${teamByAbbr[g.home]?.name}. ` +
      (final ? `Final ${g.away} ${g.score.a}, ${g.home} ${g.score.h}.` : p ? `Projected ${g.away} ${Math.round(p.pa)}, ${g.home} ${Math.round(p.ph)}; ${fav.abbr} ${Math.round(100 * fav.p)} percent.` : "Forecast not yet published.") +
      (state && final && p ? ` ${p.correct ? "Pick correct" : "Pick missed"}.` : "");
    return (
      <li class="sb" data-reveal="lift" style={`--i:${i}`} data-date={g.date} data-teams={`${g.home} ${g.away}`} data-status={g.status}>
        <a class="instrument dots" href={gameUrl(g.id)} aria-label={aria}>
          <div class="sb-top">
            <span class="when num">{final ? "Final" : g.tip ? fmtTime(g.tip) : "Time TBD"}</span>
            <span class="col">{final ? "Final" : p ? "Proj." : ""}</span>
          </div>
          {rows.map(([side, abbr, proj, fin]) => {
            const v = big(proj, fin);
            return (
              <div class={`sb-row ${winner === abbr ? "won" : ""} ${winner && winner !== abbr ? "lost" : ""}`} style={teamVars(abbr)}>
                <span class="bar" aria-hidden="true"></span>
                <span class="ab">{abbr}</span>
                <span class="nm">{nick(abbr)}{side === "home" && <span class="h"> · home</span>}</span>
                <span class="led num" data-count>{v ?? "––"}</span>
              </div>
            );
          })}
          <div class="sb-foot">
            {p && <ProbabilityBar away={g.away} home={g.home} hwp={p.hwp} />}
            {final && p && <span class="projline num">Projected {Math.round(p.pa)}–{Math.round(p.ph)}</span>}
            {state && <span class={`res ${state.c}`}>{state.t}</span>}
            {g.stype === "Playoffs" && <span class="po">Playoffs</span>}
          </div>
        </a>
      </li>
    );
  })}
</ul>

<style>
  .slateboard { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 268px), 1fr)); }
  .sb > a {
    display: block; height: 100%; text-decoration: none; color: var(--ink);
    border: 1px solid var(--rule-strong); border-radius: 6px; padding: 10px 14px 12px;
    transition: border-color 0.2s ease, transform 0.25s var(--ease-out), box-shadow 0.25s ease;
  }
  .sb > a:hover { border-color: var(--accent); transform: translateY(-2px); box-shadow: 0 10px 28px -14px rgba(13, 18, 22, 0.55); }
  .sb > a:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .sb-top { display: flex; justify-content: space-between; align-items: baseline; font-size: 0.7rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); padding-bottom: 6px; border-bottom: 1px solid var(--rule); margin-bottom: 6px; }
  .when { letter-spacing: 0.04em; color: var(--ink-2); }
  .sb-row { display: grid; grid-template-columns: 5px 3.2ch minmax(0, 1fr) auto; gap: 10px; align-items: center; padding: 4px 0; }
  .bar { align-self: stretch; border-radius: 1px; background: linear-gradient(var(--tp) 0 62%, var(--ts) 62% 100%); box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.14); }
  .ab { font-weight: 600; letter-spacing: 0.03em; }
  .nm { color: var(--ink-2); font-size: 0.85rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .h { color: var(--muted); }
  .led {
    font-size: 1.85rem; line-height: 1; font-weight: 500; color: var(--led); min-width: 3ch; text-align: right;
    text-shadow: 0 0 10px rgba(245, 185, 76, 0.35); letter-spacing: 0.03em;
  }
  .lost .led { color: #9c7a3f; text-shadow: none; }
  .won .ab::after { content: " ◂"; color: var(--led); font-size: 0.75em; }
  .sb-foot { margin-top: 8px; display: flex; flex-direction: column; gap: 6px; }
  .projline { font-size: 0.75rem; color: var(--muted); }
  .res { font-size: 0.78rem; }
  .po { font-size: 0.68rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--accent); }
  @media (prefers-reduced-motion: reduce) { .sb > a:hover { transform: none; } }
</style>
