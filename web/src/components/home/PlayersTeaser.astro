---
// "Coming soon" teaser for player stats. Deliberately vague: no dates, no
// promised features, and no numbers (the rows are empty placeholders).
---
<section class="section teaser" aria-labelledby="h-players">
  <div class="tz instrument dots" data-reveal="lift">
    <div class="copy">
      <p class="kicker"><span class="eyes" aria-hidden="true">👀</span> Coming soon</p>
      <h2 id="h-players">Player stats</h2>
      <p>The game forecasts are built from team numbers. Player-level stats are next. Not ready yet, but they're on the way.</p>
    </div>
    <div class="gw" aria-hidden="true">
    <div class="ghost">
      {[0, 1, 2, 3].map((i) => (
        <div class="gr" style={`--i:${i}`}>
          <span class="av"></span>
          <span class="ln w1"></span>
          <span class="ln w2"></span>
          <span class="ln w3"></span>
        </div>
      ))}
    </div>
    <span class="lock">Soon</span>
    </div>
  </div>
</section>

<style>
  .teaser { padding-top: var(--s5); border-top: 0; }
  .tz { display: grid; gap: var(--s5); grid-template-columns: minmax(0, 1fr); padding: var(--s5); border-radius: 8px; align-items: center; }
  @media (min-width: 760px) { .tz { grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); } }
  .copy h2 { font-size: 1.4rem; margin: 4px 0 var(--s2); }
  .copy p:last-child { margin: 0; color: var(--ink-2); font-size: 0.95rem; max-width: 46ch; }
  .kicker { color: var(--led); }
  .eyes { display: inline-block; animation: look 4s ease-in-out infinite; }
  @keyframes look { 0%, 40%, 100% { transform: translateX(0); } 50%, 60% { transform: translateX(-3px); } 70%, 80% { transform: translateX(3px); } }
  .gw { position: relative; }
  .ghost { display: grid; gap: 10px; filter: blur(1.5px); }
  .gr { display: grid; grid-template-columns: 28px 1fr 64px 64px; gap: 12px; align-items: center; }
  .av { width: 28px; height: 28px; border-radius: 50%; }
  .ln { height: 10px; border-radius: 3px; }
  .w1 { width: 80%; } .w2, .w3 { width: 100%; }
  .av, .ln { background: linear-gradient(90deg, #1d262e 0%, #2c3843 40%, #1d262e 80%); background-size: 300% 100%; animation: shimmer 2.2s linear infinite; animation-delay: calc(var(--i) * 0.15s); }
  @keyframes shimmer { from { background-position: 100% 0; } to { background-position: -200% 0; } }
  .lock { position: absolute; inset: 0; margin: auto; width: max-content; height: max-content; filter: none; font-family: var(--mono); font-size: 0.8rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--led); border: 1px solid var(--led); padding: 4px 12px; border-radius: 3px; background: rgba(13, 18, 22, 0.85); }
</style>
