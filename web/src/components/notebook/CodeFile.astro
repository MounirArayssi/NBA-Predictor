---
// Shows an excerpt of a real file from this repository, read at build time, so a
// notebook snippet can never drift from the code that actually runs.
//   <CodeFile file="data/ingestion/team_strength.py" def="update" />
//   <CodeFile file="web/scripts/notebook_figures.py" section="questionable" />
//   <CodeFile file="model/train.py" from="FEATURE_COLS = [" to="]" />
// `def` takes a function/class name and runs to the end of its body. `section`
// takes the text between "# --- name" and "# --- end name". `from`/`to` match the
// first line containing each string (the `to` line is included).
import { Code } from "astro:components";
import fs from "node:fs";
import path from "node:path";

interface Props { file: string; def?: string; section?: string; from?: string; to?: string; caption?: string; lang?: string }
const { file, def, section, from, to, caption, lang = "python" } = Astro.props;
const root = path.resolve(process.cwd(), "..");
const lines = fs.readFileSync(path.join(root, file), "utf8").replace(/\r\n/g, "\n").split("\n");
const indent = (s) => s.match(/^\s*/)[0].length;

let a = 0, b = lines.length - 1;
if (def) {
  a = lines.findIndex((l) => new RegExp(`^\\s*(def|class) ${def}\\b`).test(l));
  if (a < 0) throw new Error(`CodeFile: ${def} not found in ${file}`);
  const ind = indent(lines[a]);
  b = a;
  for (let i = a + 1; i < lines.length; i++) {
    if (lines[i].trim() === "") continue;
    if (indent(lines[i]) <= ind && !/^\s*[)\]]/.test(lines[i])) break;
    b = i;
  }
} else if (section) {
  a = lines.findIndex((l) => l.trim() === `# --- ${section}`) + 1;
  b = lines.findIndex((l) => l.trim() === `# --- end ${section}`) - 1;
  if (a <= 0 || b < a) throw new Error(`CodeFile: section ${section} not found in ${file}`);
} else if (from) {
  a = lines.findIndex((l) => l.includes(from));
  if (a < 0) throw new Error(`CodeFile: "${from}" not found in ${file}`);
  b = to ? lines.findIndex((l, i) => i > a && l.includes(to)) : a;
  if (b < 0) throw new Error(`CodeFile: "${to}" not found after "${from}" in ${file}`);
}
const chunk = lines.slice(a, b + 1);
const cut = Math.min(...chunk.filter((l) => l.trim()).map(indent));
const code = chunk.map((l) => l.slice(cut)).join("\n").replace(/\s+$/, "");
---
<figure class="codefile">
  <figcaption><span class="path">{file}</span><span class="lines">lines {a + 1}–{b + 1}</span></figcaption>
  <Code code={code} lang={lang} theme="github-light" />
  {caption && <p class="cap">{caption}</p>}
</figure>
<style>
  .codefile { margin: var(--s5) 0; font-family: var(--sans); border: 1px solid var(--rule); border-radius: 4px; background: var(--surface); overflow: hidden; }
  figcaption { display: flex; justify-content: space-between; gap: var(--s3); flex-wrap: wrap; padding: 6px 12px; border-bottom: 1px solid var(--rule); background: #eceee9; font-family: var(--mono); font-size: 0.78rem; color: var(--ink-2); }
  .lines { color: var(--muted); }
  .codefile :global(pre) { margin: 0; padding: 12px 14px; font-family: var(--mono); font-size: 0.8rem; line-height: 1.55; overflow-x: auto; background: var(--surface) !important; }
  .codefile :global(pre code) { border: 0; padding: 0; background: none; font-size: inherit; }
  .cap { margin: 0; padding: 8px 12px; border-top: 1px solid var(--rule); font-size: 0.85rem; color: var(--muted); }
</style>
