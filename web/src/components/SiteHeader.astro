---
import { TITLE, site } from "../lib/data.js";
import LogoMark from "./LogoMark.astro";
interface Props { section: string }
const { section } = Astro.props;
// Main pages, then the research pages grouped under one menu (each keeps its own page).
const links = [
  ["home", "/", "Home"],
  ["forecasts", "/forecasts/", "Forecasts"],
  ["teams", "/teams/", "Teams"],
  ["performance", "/performance/", "Performance"],
];
const research = [
  ["surprises", "/surprises/", "Surprises", "Games furthest from the forecast"],
  ["what-wins", "/what-wins/", "What wins", "Which pre-game numbers line up with wins"],
  ["notebook", "/notebook/", "Notebook", "Model changes and ideas tested"],
];
const inResearch = research.some(([key]) => key === section);
---
<header class="site-header instrument">
  <div class="wrap bar">
    <a class="title" href="/" aria-label={TITLE}><LogoMark class="mark" /><span class="wm"><span class="the">The</span> Hoop Ledger</span></a>
    <span class="season"><i class="led" aria-hidden="true"></i>{site.season} season</span>
    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="site-nav">Menu</button>
    <nav id="site-nav" aria-label="Primary">
      <ul>
        {links.map(([key, href, label]) => (
          <li><a href={href} aria-current={section === key ? "page" : undefined}>{label}</a></li>
        ))}
        <li class="group">
          <details class="drop">
            <summary aria-current={inResearch ? "page" : undefined}>Research</summary>
            <ul class="sub">
              {research.map(([key, href, label, hint]) => (
                <li><a href={href} aria-current={section === key ? "page" : undefined}><span class="lb">{label}</span><span class="hint">{hint}</span></a></li>
              ))}
            </ul>
          </details>
        </li>
        <li><a href="/about/" aria-current={section === "about" ? "page" : undefined}>About</a></li>
      </ul>
    </nav>
  </div>
</header>

<script>
  const btn = document.querySelector(".menu-btn");
  const nav = document.getElementById("site-nav");
  btn?.addEventListener("click", () => {
    const open = btn.getAttribute("aria-expanded") === "true";
    btn.setAttribute("aria-expanded", String(!open));
    nav?.classList.toggle("open", !open);
  });
  // Close the Research menu on an outside click or Escape.
  const drop = document.querySelector<HTMLDetailsElement>("details.drop");
  document.addEventListener("click", (e) => {
    if (drop?.open && !drop.contains(e.target as Node)) drop.open = false;
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && drop?.open) { drop.open = false; drop.querySelector("summary")?.focus(); return; }
    if (e.key === "Escape" && btn?.getAttribute("aria-expanded") === "true") {
      btn.setAttribute("aria-expanded", "false");
      nav?.classList.remove("open");
      (btn as HTMLElement).focus();
    }
  });
</script>

<style>
  .title :global(.mark) { width: 1.35em; height: 1.35em; vertical-align: -0.3em; margin-right: 0.45em; transition: transform 0.5s var(--ease-out); }
  .title:hover :global(.mark) { transform: rotate(-14deg); }
  .the { font-family: var(--sans); font-size: 0.62em; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: var(--header-muted); vertical-align: 0.25em; margin-right: 1px; }
  .site-header { background: var(--header); color: var(--header-ink); position: relative; }
  /* A single thin trace that runs once along the header's bottom edge. */
  .site-header::after { content: ""; position: absolute; left: 0; bottom: -1px; height: 1px; width: 100%; background: var(--accent); transform: scaleX(0); transform-origin: left; animation: trace 1.4s var(--ease-out) 0.2s forwards; opacity: 0.7; }
  @keyframes trace { to { transform: scaleX(1); opacity: 0.35; } }
  .led { display: inline-block; width: 6px; height: 6px; border-radius: 50%; background: var(--led); margin-right: 8px; vertical-align: 1px; box-shadow: 0 0 6px var(--led); animation: pulse 2.8s ease-in-out infinite; }
  @keyframes pulse { 50% { opacity: 0.35; box-shadow: 0 0 2px var(--led); } }
  @media (prefers-reduced-motion: reduce) { .site-header::after { transform: none; opacity: 0.35; } }
  .bar { display: flex; align-items: center; gap: var(--s4); min-height: 56px; flex-wrap: wrap; }
  .title {
    color: var(--header-ink); text-decoration: none; font-family: var(--serif); font-weight: 600;
    font-size: 1.25rem; letter-spacing: -0.005em;
  }
  .season { font-size: 0.75rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--header-muted); }
  nav { margin-left: auto; }
  nav ul { list-style: none; margin: 0; padding: 0; display: flex; gap: 2px; }
  nav a {
    display: block; padding: 18px 10px 15px; color: var(--header-muted); text-decoration: none;
    font-size: 0.9rem; font-weight: 500; border-bottom: 3px solid transparent;
  }
  nav a:hover { color: var(--header-ink); }
  nav a[aria-current="page"] { color: var(--header-ink); border-bottom-color: var(--accent); }
  .group { position: relative; }
  .drop summary {
    list-style: none; cursor: pointer; padding: 18px 10px 15px; color: var(--header-muted); font-size: 0.9rem; font-weight: 500;
    border-bottom: 3px solid transparent; white-space: nowrap;
  }
  .drop summary::-webkit-details-marker { display: none; }
  .drop summary::after { content: ""; display: inline-block; width: 5px; height: 5px; margin-left: 7px; border-right: 1.5px solid currentColor; border-bottom: 1.5px solid currentColor; transform: rotate(45deg); vertical-align: 3px; transition: transform 0.2s var(--ease-out); }
  .drop[open] summary::after { transform: rotate(225deg); vertical-align: -1px; }
  .drop summary:hover, .drop[open] summary { color: var(--header-ink); }
  .drop summary[aria-current="page"] { color: var(--header-ink); border-bottom-color: var(--accent); }
  .drop summary:focus-visible { outline-color: var(--accent); }
  .sub { position: absolute; right: 0; top: 100%; z-index: 20; display: block !important; min-width: 250px; padding: 6px !important; background: var(--header); border: 1px solid var(--rule-strong); border-radius: var(--radius); box-shadow: 0 10px 24px rgba(0, 0, 0, 0.25); }
  .sub a { padding: 9px 10px; border-bottom: 0; border-radius: var(--radius); }
  .sub a:hover { background: rgba(255, 255, 255, 0.06); }
  .sub a[aria-current="page"] { box-shadow: inset 3px 0 0 var(--accent); }
  .sub .lb { display: block; color: var(--header-ink); }
  .sub .hint { display: block; font-size: 0.76rem; font-weight: 400; color: var(--header-muted); margin-top: 1px; }
  nav a:focus-visible, .title:focus-visible, .menu-btn:focus-visible { outline-color: var(--accent); }
  .menu-btn {
    display: none; margin-left: auto; font: inherit; font-size: 0.875rem; color: var(--header-ink);
    background: transparent; border: 1px solid var(--rule-strong); border-radius: var(--radius); padding: 6px 12px; min-height: 40px; cursor: pointer;
  }
  @media (max-width: 760px) {
    .season { display: none; }
    :global(html.js) .menu-btn { display: inline-block; }
    :global(html.js) nav { display: none; width: 100%; margin: 0; }
    :global(html.js) nav.open { display: block; }
    nav { width: 100%; }
    nav ul { flex-direction: column; padding-bottom: var(--s2); }
    :global(html:not(.js)) nav ul { flex-direction: row; flex-wrap: wrap; }
    nav a { padding: 12px 0; border-bottom: 1px solid var(--rule); }
    nav a[aria-current="page"] { border-bottom-color: var(--rule); box-shadow: inset 3px 0 0 var(--accent); padding-left: 12px; }
    .drop summary { padding: 12px 0; border-bottom: 1px solid var(--rule); }
    .drop summary[aria-current="page"] { border-bottom-color: var(--rule); }
    .sub { position: static; min-width: 0; padding: 0 0 0 14px !important; border: 0; box-shadow: none; background: transparent; }
    .sub a { border-radius: 0; border-bottom: 1px solid var(--rule); }
  }
</style>
