---
// One team's pregame Elo over its recent games with a forecast, in team color,
// against the 1500 long-run average. Season starts are marked, because Elo is
// pulled toward the mean between seasons.
interface Props { hist: [string, number][]; abbr: string; color: string }
const { hist, abbr, color } = Astro.props;
const W = 560, H = 240, m = { l: 44, r: 52, t: 14, b: 30 };
const vals = hist.map((h) => h[1]);
const lo = Math.floor((Math.min(...vals, 1500) - 10) / 50) * 50, hi = Math.ceil((Math.max(...vals, 1500) + 10) / 50) * 50;
const n = hist.length;
const x = (i) => m.l + ((W - m.l - m.r) * i) / Math.max(1, n - 1);
const y = (v) => m.t + (H - m.t - m.b) * (1 - (v - lo) / (hi - lo));
const d = hist.map((h, i) => `${i ? "L" : "M"}${x(i).toFixed(1)},${y(h[1]).toFixed(1)}`).join(" ");
const area = `${d} L${x(n - 1).toFixed(1)},${y(lo)} L${x(0).toFixed(1)},${y(lo)} Z`;
const ticks = [];
for (let v = lo; v <= hi; v += 50) ticks.push(v);
// Season boundary: a gap of more than 60 days between consecutive games.
const breaks = hist.map((h, i) => (i && Date.parse(h[0]) - Date.parse(hist[i - 1][0]) > 60 * 864e5 ? i : -1)).filter((i) => i > 0);
const fmt = (s) => new Date(s + "T12:00:00Z").toLocaleDateString("en-US", { timeZone: "UTC", month: "short", year: "numeric" });
const last = hist.at(-1);
---
<figure class="chart elo-trend" style={`--tc:${color}`}>
  <div class="chart-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-labelledby={`et-${abbr}`}>
      <title id={`et-${abbr}`}>{abbr} pregame Elo over its last {n} games with a forecast, from {hist[0][1]} to {last[1]}</title>
      {ticks.map((v) => (<g><line class="grid" x1={m.l} x2={W - m.r} y1={y(v)} y2={y(v)} /><text x={m.l - 8} y={y(v) + 4} text-anchor="end">{v}</text></g>))}
      <line x1={m.l} x2={W - m.r} y1={y(1500)} y2={y(1500)} stroke="var(--neutral-mark)" stroke-dasharray="4 4" />
      {breaks.map((i) => (<g><line x1={(x(i - 1) + x(i)) / 2} x2={(x(i - 1) + x(i)) / 2} y1={m.t} y2={H - m.b} class="axis" stroke-dasharray="2 3" /><text x={(x(i - 1) + x(i)) / 2 + 4} y={m.t + 10}>new season</text></g>))}
      <path d={area} class="area" />
      <path d={d} class="ln" />
      <circle cx={x(n - 1)} cy={y(last[1])} r="4.5" class="dot" />
      <text x={x(n - 1) + 8} y={y(last[1]) + 4} class="strong">{last[1]}</text>
      <text x={m.l} y={H - 8}>{fmt(hist[0][0])}</text>
      <text x={W - m.r} y={H - 8} text-anchor="end">{fmt(last[0])}</text>
    </svg>
  </div>
  <figcaption>Pregame Elo stored with each of {abbr}'s last {n} forecasts. Dashed: 1500, the long-run average.</figcaption>
</figure>
<style>
  .elo-trend .ln { fill: none; stroke: var(--tc); stroke-width: 2.25; stroke-linejoin: round; }
  .elo-trend .area { fill: var(--tc); opacity: 0.08; }
  .elo-trend .dot { fill: var(--tc); stroke: var(--paper); stroke-width: 2; }
  .elo-trend :global(svg) { min-width: 0 !important; }
</style>
