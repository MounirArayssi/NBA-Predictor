---
import { site, fmtDateTime } from "../lib/data.js";
---
<footer class="site-footer">
  <div class="wrap grid">
    <div>
      <p class="strong">The Hoop Ledger</p>
      <p>An independent NBA forecasting project. Every forecast graded against the final score.</p>
      <p>Not affiliated with the NBA or any team. Forecasts are for analysis and entertainment, not betting advice.</p>
    </div>
    <div>
      <p class="strong">Data</p>
      <p>Results and box scores: NBA Stats. Player availability: the official NBA injury report. Market lines, where shown, are not model inputs.</p>
    </div>
    <div>
      <p class="strong">This edition</p>
      <p>Data exported <time datetime={site.generated_at}>{fmtDateTime(site.generated_at)}</time>.</p>
      <p><a href="/methodology/">Methodology</a> · <a href="/forecasts/archive/">Forecast archive</a> · <a href="/notebook/">Notebook</a></p>
    </div>
  </div>
</footer>
<style>
  .site-footer { margin-top: var(--s7); border-top: 2px solid var(--rule-heavy); background: var(--surface); }
  .grid { display: grid; gap: var(--s3) var(--s6); padding-block: var(--s4) var(--s5); font-size: 0.8rem; line-height: 1.45; color: var(--ink-2); }
  @media (min-width: 800px) { .grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .strong { font-weight: 600; color: var(--ink); margin-bottom: 2px; }
  p { margin-bottom: var(--s1); }
</style>
