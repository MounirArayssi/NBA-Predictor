---
import Base from "../../layouts/Base.astro";
import GameCourt from "../../components/GameCourt.astro";
import InsideForecast from "../../components/InsideForecast.astro";
import RawBreakdown from "../../components/RawBreakdown.astro";
import ForecastMiss from "../../components/ForecastMiss.astro";
import StreakBadge from "../../components/StreakBadge.astro";
import { record } from "../../lib/streaks.js";
import { teamVars } from "../../lib/teamColors.js";
import breakdowns from "../../data/breakdowns.json";
import { games, gameById, teamByAbbr, teamUrl, gameUrl, fmtLongDate, fmtShortDate, fmtTime, fmtDateTime, favorite, signed, fixed } from "../../lib/data.js";

export function getStaticPaths() {
  return games.map((g) => ({ params: { id: g.id } }));
}

const g = gameById[Astro.params.id];
const H = teamByAbbr[g.home], A = teamByAbbr[g.away];
const p = g.fc;
const fav = favorite(p, g);
const final = g.status === "final";
const winner = final ? (g.score.h > g.score.a ? g.home : g.away) : null;

// Neighbouring games for each team among the pages that exist.
const sorted = [...games].sort((x, y) => (x.date + (x.tip || "")).localeCompare(y.date + (y.tip || "")));
function neighbours(abbr) {
  const list = sorted.filter((x) => x.home === abbr || x.away === abbr);
  const i = list.findIndex((x) => x.id === g.id);
  return { prev: list[i - 1], next: list[i + 1] };
}
const nb = { [g.away]: neighbours(g.away), [g.home]: neighbours(g.home) };

const I = g.inputs;
const inputRows = I ? [
  ["Elo rating", "elo", 0, "higher"],
  ["Season scoring margin", "season_margin", 1, "higher"],
  ["Offensive rating, last 10", "off_rating", 1, "higher"],
  ["Defensive rating, last 10", "def_rating", 1, "lower"],
  ["Points per game missing (Out/Doubtful)", "missing_pts", 1, "lower"],
  ["Rest days", "rest_days", 0, null],
  ["Second night of a back-to-back", "back_to_back", 0, null],
  ["Games played this season", "games_played", 0, null],
] : [];
const fmtIn = (k, v, d) => (v == null ? "–" : k === "back_to_back" ? (v ? "Yes" : "No") : k === "season_margin" ? signed(v, d) : Number(v).toFixed(d));

// Plain factual comparisons only (no attribution of the forecast to any input).
const notes = [];
if (I) {
  const e = [I.away.elo, I.home.elo];
  if (e[0] != null && e[1] != null && Math.abs(e[0] - e[1]) >= 25) {
    const hi = e[0] > e[1] ? A : H;
    notes.push(`${hi.name} entered with the higher Elo rating (${Math.round(Math.max(...e))} to ${Math.round(Math.min(...e))}).`);
  }
  for (const [t, side] of [[A, "away"], [H, "home"]]) {
    if ((I[side].missing_pts ?? 0) >= 10) notes.push(`${t.name} were missing ${I[side].missing_pts.toFixed(1)} points per game of rotation scoring on the injury report used for the forecast.`);
    if (I[side].back_to_back) notes.push(`${t.name} were on the second night of a back-to-back.`);
  }
}

const desc = p
  ? `${A.name} at ${H.name}, ${fmtLongDate(g.date)}: forecast ${fav.abbr} ${Math.round(100 * fav.p)}% (projected ${g.away} ${Math.round(p.pa)}, ${g.home} ${Math.round(p.ph)})${final ? `; final ${g.away} ${g.score.a}, ${g.home} ${g.score.h}` : ""}.`
  : `${A.name} at ${H.name}, ${fmtLongDate(g.date)}.`;
// Recent form: the box-score game logs behind the 10-game ratings (breakdowns.json),
// newest first; the first 5 show, the rest open with "Show all 10 games".
const bdGame = breakdowns.games[g.id];
const hasLog = !!(bdGame?.home?.games?.length || bdGame?.away?.games?.length);
const gameOn = (d, abbr) => games.find((x) => x.date === d && (x.home === abbr || x.away === abbr))?.id;
---
<Base title={`${g.away} at ${g.home}, ${fmtShortDate(g.date)}`} description={desc} section="forecasts" type="article">
  <div class="wrap">
    <header class="page-head">
      <a class="back" href={`/forecasts/?date=${g.date}`}>← Forecasts for {fmtShortDate(g.date)}</a>
      <p class="kicker">{g.season} · {g.stype} · {final ? "Final" : g.status === "scheduled" ? "Scheduled" : "Result not recorded"}</p>
      <h1><a class="tn" href={teamUrl(g.away)}>{A.name}</a> at <a class="tn" href={teamUrl(g.home)}>{H.name}</a></h1>
      <p class="lede">{fmtLongDate(g.date)}{g.tip ? ` · tip-off ${fmtTime(g.tip)}` : " · tip-off time not recorded"}{!final && g.tip && <> <span class="cd" data-tip={g.tip}></span></>}</p>
      <p class="recs">
        {[[g.away, false], [g.home, true]].map(([abbr, home]) => (
          <span class="rc"><i class="chip" style={teamVars(abbr)} aria-hidden="true"></i>{home && <span class="at">@</span>}<b>{abbr}</b> <span class="num">{record(abbr, g.season, g.date)}</span><StreakBadge abbr={abbr} season={g.season} date={g.date} /></span>
        ))}
        <span class="rn">records going into the game</span>
        {final && <a class="ext" href={`https://www.nba.com/game/${g.id}`} target="_blank" rel="noopener">NBA.com recap ↗</a>}
      </p>
    </header>

    {p && <GameCourt away={g.away} home={g.home} hwp={p.hwp} pa={p.pa} ph={p.ph} fa={g.score?.a} fh={g.score?.h} />}

    <section class="section top" aria-labelledby="h-fc">
      <div class="cols cols-main">
        <div>
          <h2 id="h-fc" class="sr-only">Forecast and result</h2>
          <div class="table-scroll">
            <table class="scoretable">
              <thead><tr><th>Team</th><th class="r">Projected</th><th class="r">Final</th>{final && p && <th class="r">Difference</th>}</tr></thead>
              <tbody>
                {[[A, g.away, p?.pa, g.score?.a], [H, g.home, p?.ph, g.score?.h]].map(([t, abbr, proj, fin]) => (
                  <tr class={winner === abbr ? "won" : ""}>
                    <th scope="row"><i class="chip" style={teamVars(abbr)} aria-hidden="true"></i> <span class="ab">{abbr}</span> {t.name}{abbr === g.home ? <span class="muted"> (home)</span> : null}</th>
                    <td class="r num proj">{proj != null ? Math.round(proj) : "–"}</td>
                    <td class="r num">{fin ?? "–"}</td>
                    {final && p && <td class="r num">{signed(fin - proj, 0)}</td>}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          {p ? (
            <div class="forecast">
              <p class="big">Forecast: <strong>{teamByAbbr[fav.abbr].name}</strong> to win, <span class="num">{Math.round(100 * fav.p)}%</span> win probability, projected margin <span class="num">{Math.abs(Math.round(p.ph) - Math.round(p.pa))}</span>.</p>
            </div>
          ) : (
            <p class="state">{final ? "No forecast is stored for this game." : "The forecast for this game has not been published yet."}</p>
          )}
        </div>
        <aside class="meta-box" aria-label="Forecast record">
          {p ? (
            <dl>
              {p.origin === "walkforward"
                ? <><dt>Forecast type</dt><dd>Walk-forward: produced after the game by a model trained only on earlier seasons</dd></>
                : <><dt>Forecast made</dt><dd class="num">{fmtDateTime(p.at) ?? "–"}</dd></>}
              <dt>Scheduled tip-off</dt><dd class="num">{g.tip ? fmtDateTime(g.tip) : "Not recorded"}</dd>
              {final && <><dt>Winner</dt><dd class={`res ${p.correct ? "ok" : "miss"}`}>{p.correct ? "✓ Correct pick" : "✗ Missed pick"}</dd></>}
            </dl>
          ) : <p class="note">No forecast is stored for this game.</p>}
        </aside>
      </div>
    </section>

    {p && <InsideForecast g={g} />}
    {p && g.inputs && <RawBreakdown g={g} />}
    {final && p && <ForecastMiss g={g} />}

    <h2 class="more-head">More about this game</h2>

    {final && p && (
      <section class="section" aria-labelledby="h-rev">
        <details class="fold"><summary><h2 id="h-rev">Where the forecast differed from the result</h2></summary>
        <div class="table-scroll narrow">
          <table>
            <thead><tr><th>Measure</th><th class="r">Forecast</th><th class="r">Actual</th><th class="r">Actual − forecast</th></tr></thead>
            <tbody>
              <tr><td>Home margin ({g.home})</td><td class="r num">{signed(p.ph - p.pa, 0)}</td><td class="r num">{signed(g.score.h - g.score.a, 0)}</td><td class="r num">{signed(p.margin_err, 0)}</td></tr>
              <tr><td>Total points</td><td class="r num">{Math.round(p.ph + p.pa)}</td><td class="r num">{g.score.h + g.score.a}</td><td class="r num">{signed(p.total_err, 0)}</td></tr>
              <tr><td>{g.away} points</td><td class="r num">{Math.round(p.pa)}</td><td class="r num">{g.score.a}</td><td class="r num">{signed(p.away_err, 0)}</td></tr>
              <tr><td>{g.home} points</td><td class="r num">{Math.round(p.ph)}</td><td class="r num">{g.score.h}</td><td class="r num">{signed(p.home_err, 0)}</td></tr>
            </tbody>
          </table>
        </div>
        </details>
      </section>
    )}

    {final && g.quarters?.h && g.quarters?.a && (
      <section class="section" aria-labelledby="h-q">
        <details class="fold"><summary><h2 id="h-q">Score by quarter</h2></summary>
        <div class="table-scroll narrow">
          <table>
            <thead><tr><th>Team</th><th class="r">Q1</th><th class="r">Q2</th><th class="r">Q3</th><th class="r">Q4</th><th class="r">OT</th><th class="r">Final</th></tr></thead>
            <tbody>
              {[[g.away, g.quarters.a], [g.home, g.quarters.h]].map(([abbr, q]) => (
                <tr><th scope="row">{abbr}</th>{q.q.map((v) => <td class="r num">{v}</td>)}<td class="r num">{q.total - q.q.reduce((s, v) => s + v, 0) || "–"}</td><td class="r num"><strong>{q.total}</strong></td></tr>
              ))}
            </tbody>
          </table>
        </div>
        </details>
      </section>
    )}

    <div class="lower">
      {g.injuries && (
        <section class="section" aria-labelledby="h-inj">
          <details class="fold" open={!final}><summary><h2 id="h-inj">Injury report</h2></summary>
          <p class="note">Official NBA injury report, {g.injuries.report} (the latest stored report before the forecast was saved). Two-way and G League assignments are omitted. The model counts players listed Out or Doubtful (status in bold); Questionable players are treated as available.</p>
          <div class="form-pair inj-pair">
          {[[A, g.away, g.injuries.away], [H, g.home, g.injuries.home]].map(([t, abbr, list]) => (
            <div class="inj" style={teamVars(abbr)}>
              <h3 class="team-band"><span class="ab">{abbr}</span> <span class="name">{t.name}</span>{abbr === g.home ? <span class="side"> (home)</span> : null}</h3>
              {list.length ? (
                <ul>{list.map((e) => {
                  const counted = /^(out|doubtful)$/i.test(e.status);
                  return <li><span class={`st ${counted ? "counted" : ""}`}>{e.status}</span> <span class="pn">{e.name}</span>{e.reason && <span class="why">{e.reason}</span>}</li>;
                })}</ul>
              ) : <p class="muted">No players listed.</p>}
            </div>
          ))}
          </div>
          </details>
        </section>
      )}
    </div>

    <div class="lower">
      <section class="section" aria-labelledby="h-form">
        <details class="fold"><summary><h2 id="h-form">Recent form before this game</h2></summary>
        <div class={`form-pair${hasLog ? " wide" : ""}`}>
        {[[A, g.away], [H, g.home]].map(([t, abbr]) => {
          const side = abbr === g.home ? "home" : "away";
          const log = (bdGame?.[side]?.games || []).slice().reverse();
          const simple = g.form[side] || [];
          return (
          <div class="form" style={teamVars(abbr)}>
            <h3 class="team-band"><span class="ab">{abbr}</span> <span class="name">{t.name}</span>{abbr === g.home ? <span class="side"> (home)</span> : null}</h3>
            {log.length ? (
              <div class="table-scroll">
                <table class="log" data-rows={log.length}>
                  <thead><tr><th>Date</th><th>Opp</th><th>Result</th><th class="r">FG</th><th class="r">3P</th><th class="r">FT</th><th class="r">TOV</th><th class="r">OREB</th><th class="r">Off</th><th class="r">Def</th><th class="r">Pace</th></tr></thead>
                  <tbody>
                    {log.map((x, k) => {
                      const id = gameOn(x.d, abbr);
                      const won = x.pf > x.pa;
                      return (
                      <tr class={k >= 5 ? "older" : ""}>
                        <td class="nw num">{id ? <a href={gameUrl(id)}>{fmtShortDate(x.d)}</a> : fmtShortDate(x.d)}</td>
                        <td class="nw">{x.h ? "vs" : "at"} <a href={teamUrl(x.o)}>{x.o}</a></td>
                        <td class="num nw res-c"><span class={won ? "w" : "l"}>{won ? "W" : "L"}</span> {x.pf}–{x.pa}</td>
                        <td class="r num">{x.s[0]}-{x.s[1]}</td><td class="r num">{x.s[2]}-{x.s[3]}</td><td class="r num">{x.s[4]}-{x.s[5]}</td>
                        <td class="r num">{x.s[6]}</td><td class="r num">{x.s[7] ?? "–"}</td>
                        <td class="r num">{fixed(x.or_, 1)}</td><td class="r num">{fixed(x.dr, 1)}</td><td class="r num">{fixed(x.pc, 1)}</td>
                      </tr>
                    ); })}
                  </tbody>
                </table>
              </div>
            ) : simple.length ? (
              <table>
                <thead><tr><th>Date</th><th>Opp</th><th class="r">Result</th></tr></thead>
                <tbody>{simple.map((r) => (
                  <tr>
                    <td class="num">{gameById[r.id] ? <a href={gameUrl(r.id)}>{fmtShortDate(r.date)}</a> : fmtShortDate(r.date)}</td>
                    <td>{r.home ? "vs" : "at"} <a href={teamUrl(r.opp)}>{r.opp}</a></td>
                    <td class="r num"><span class={r.won ? "w" : "l"}>{r.won ? "W" : "L"}</span> {r.pts}–{r.opp_pts}</td>
                  </tr>
                ))}</tbody>
              </table>
            ) : <p class="muted">No earlier games in the data.</p>}
          </div>
          ); })}
        </div>
        {hasLog && (
          <>
            <button type="button" class="btn more10" hidden aria-expanded="false">Show all 10 games</button>
            <p class="note">Off and Def are points scored and allowed per 100 possessions in each game; the 10-game averages are the offensive and defensive ratings the model uses. OREB is missing (–) where the source data didn't record it.</p>
          </>
        )}
        </details>
      </section>

      <section class="section" aria-labelledby="h-h2h">
        <details class="fold"><summary><h2 id="h-h2h">Previous meetings</h2></summary>
        {g.h2h.length ? (
          <table>
            <thead><tr><th>Date</th><th>Matchup</th><th class="r">Score</th></tr></thead>
            <tbody>{g.h2h.map((r) => (
              <tr>
                <td class="num">{gameById[r.id] ? <a href={gameUrl(r.id)}>{fmtShortDate(r.date)}</a> : fmtShortDate(r.date)}<span class="muted"> {r.season}</span></td>
                <td>{r.away} at {r.home}</td>
                <td class="r num">{r.away} {r.as_} – {r.hs} {r.home}</td>
              </tr>
            ))}</tbody>
          </table>
        ) : <p class="muted">No earlier meetings since 2021-22 in the data.</p>}
        </details>
      </section>
    </div>

    <nav class="section related" aria-label="Related pages">
      {[[A, g.away], [H, g.home]].map(([t, abbr]) => (
        <div>
          <p class="kicker">{t.name}</p>
          <p><a href={teamUrl(abbr)}>Team profile</a></p>
          {nb[abbr].prev && <p>Previous: <a href={gameUrl(nb[abbr].prev.id)}>{nb[abbr].prev.away} at {nb[abbr].prev.home}, {fmtShortDate(nb[abbr].prev.date)}</a></p>}
          {nb[abbr].next && <p>Next: <a href={gameUrl(nb[abbr].next.id)}>{nb[abbr].next.away} at {nb[abbr].next.home}, {fmtShortDate(nb[abbr].next.date)}</a></p>}
        </div>
      ))}
    </nav>
  </div>
</Base>

<script>
  // Links to a folded section (e.g. "#h-form") open it.
  const openTarget = () => {
    const el = location.hash && document.getElementById(location.hash.slice(1));
    const d = el?.closest("details");
    if (d) d.open = true;
  };
  openTarget();
  window.addEventListener("hashchange", openTarget);

  // Recent form: 5 games show; the button reveals all 10 behind the ratings.
  for (const btn of document.querySelectorAll<HTMLButtonElement>(".more10")) {
    const pair = btn.parentElement?.querySelector(".form-pair");
    if (!pair || !pair.querySelector("tr.older")) continue;
    btn.hidden = false;
    btn.addEventListener("click", () => {
      const all = pair.classList.toggle("all");
      btn.setAttribute("aria-expanded", String(all));
      btn.textContent = all ? "Show last 5 games" : "Show all 10 games";
    });
  }
</script>

<style>
  .tn { color: inherit; text-decoration: none; }
  /* Detail sections fold under their headings so the forecast stays in front. */
  .fold > summary { list-style: none; cursor: pointer; display: flex; align-items: center; gap: 10px; padding-bottom: 6px; border-bottom: 1px solid var(--rule); }
  .fold > summary::-webkit-details-marker { display: none; }
  .fold > summary h2 { margin: 0; }
  .fold > summary::after { content: ""; flex: none; width: 7px; height: 7px; margin-left: auto; border-right: 2px solid var(--muted); border-bottom: 2px solid var(--muted); transform: rotate(45deg); transition: transform 0.2s var(--ease-out); }
  .fold[open] > summary::after { transform: rotate(225deg); }
  .fold > summary:hover h2 { color: var(--accent); }
  .fold[open] > summary { margin-bottom: var(--s3); }
  .section:has(> .fold) { padding-block: 0; border-top: 0; }
  .fold > summary { padding: 14px 0; margin: 0; }
  .fold > summary h2 { font-family: var(--sans); font-size: 1rem; font-weight: 600; }
  .fold[open] > summary { margin-bottom: var(--s3); }
  .fold[open] { padding-bottom: var(--s4); }
  .more-head { margin: var(--s7) 0 var(--s2); padding-top: var(--s6); border-top: 1px solid var(--rule); }
  /* The two teams sit side by side inside an open fold on wide screens. */
  @media (min-width: 800px) {
  }
  .recs { display: flex; flex-wrap: wrap; gap: 6px 18px; align-items: center; margin-top: var(--s3); font-size: 0.95rem; }
  .rc { display: inline-flex; align-items: center; gap: 6px; }
  .rc .at { color: var(--muted); margin-right: -3px; }
  .rn { font-size: 0.8rem; color: var(--muted); }
  .ext { font-size: 0.85rem; margin-left: auto; }
  .tn:hover { text-decoration: underline; }
  .top { border-top: 0; padding-top: 0; }
  .scoretable { font-size: 1.05rem; }
  .scoretable th[scope="row"] { font-weight: 500; }
  .scoretable .ab { font-weight: 600; display: inline-block; min-width: 3ch; }
  .scoretable td { font-size: 1.4rem; }
  .scoretable .proj { color: var(--model); }
  .scoretable tr.won td:nth-child(3) { font-weight: 600; }
  .forecast { margin-top: var(--s5); }
  .big { font-size: 1.05rem; }
  .meta-box { border-top: 2px solid var(--rule-heavy); padding-top: var(--s3); }
  dl { display: grid; grid-template-columns: max-content minmax(0, 1fr); gap: var(--s2) var(--s4); margin: 0 0 var(--s4); font-size: 0.9rem; }
  dt { color: var(--muted); }
  dd { margin: 0; }
  .narrow { max-width: 680px; }
  .facts { margin: var(--s4) 0 0; padding-left: 1.1em; color: var(--ink-2); font-size: 0.95rem; }
  .lower h2 + .note, .lower h2 + table { margin-top: var(--s2); }
  /* Recent form: the two teams side by side, each under a band in its primary color. */
  .form-pair { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: var(--s4); }
  .form { min-width: 0; }
  .team-band { margin: 0 0 var(--s2); padding: 6px 10px; border-radius: var(--radius); background: var(--tp); color: var(--tf); font-family: var(--sans); font-size: 0.95rem; font-weight: 600; line-height: 1.3; box-shadow: inset -6px 0 0 var(--ts); }
  .team-band .ab { font-weight: 700; margin-right: 2px; }
  .team-band .side { font-weight: 400; }
  .form table { font-size: 0.85rem; }
  /* Box-score logs: side by side only where 11 columns fit; stacked (and scrollable) below. */
  .form-pair.wide { grid-template-columns: minmax(0, 1fr); gap: var(--s5); }
  @media (min-width: 1100px) { .form-pair.wide { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); } }
  .form .log { font-size: 0.8rem; }
  .form .log th, .form .log td { padding: 5px 8px 5px 0; white-space: nowrap; }
  .form .log .res-c { padding-right: 12px; }
  .form .nw { white-space: nowrap; }
  .form .w { color: var(--model); font-weight: 700; }
  .form .l { color: var(--accent); font-weight: 700; }
  :global(html.js) .form .log tr.older { display: none; }
  :global(html.js) .form-pair.all .log tr.older { display: table-row; }
  .more10 { margin-top: var(--s3); }
  .form .short { display: none; }
  @media (max-width: 559px) { .form .short { display: inline; } }
  @media (max-width: 559px) {
    .form-pair { gap: var(--s3); }
    .team-band { font-size: 0.85rem; padding: 5px 8px; }
    .form-pair:not(.wide) .team-band .name { display: none; }
    .form-pair:not(.wide) table { font-size: 0.7rem; }
    .form-pair:not(.wide) th, .form-pair:not(.wide) td { padding-inline: 2px; white-space: nowrap; }
    .form .long { display: none; }
  }
  /* Injury report: same paired, team-banded layout as Recent form. */
  .inj { min-width: 0; }
  .inj-pair { margin-top: var(--s3); }
  .inj ul { list-style: none; margin: 0; padding: 0; font-size: 0.92rem; }
  .inj li { padding: 6px 0; border-bottom: 1px solid var(--rule); display: flex; flex-wrap: wrap; align-items: baseline; column-gap: 8px; }
  .inj .pn { font-weight: 600; }
  .inj .why { flex-basis: 100%; font-size: 0.8rem; color: var(--muted); padding-left: calc(9.5 * 0.7rem + 8px); }
  .st { display: inline-block; min-width: 9.5em; font-size: 0.7rem; font-weight: 600; letter-spacing: 0.05em; text-transform: uppercase; color: var(--muted); }
