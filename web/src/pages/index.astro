---
import Base from "../layouts/Base.astro";
import SlateBoard from "../components/home/SlateBoard.astro";
import DataBall from "../components/home/DataBall.astro";
import Scoreboard from "../components/home/Scoreboard.astro";
import WeekSurprise from "../components/home/WeekSurprise.astro";
import fs from "node:fs";
import path from "node:path";
import { TITLE, site, games, performance, etDate, fmtLongDate, fmtDateTime, fmtShortDate, pct100, fixed } from "../lib/data.js";

const buildDay = etDate(new Date(site.generated_at));
const current = games.filter((g) => g.season === site.season);
const byDate = Map.groupBy ? Map.groupBy(current, (g) => g.date) : current.reduce((m, g) => m.set(g.date, [...(m.get(g.date) || []), g]), new Map());
const dates = [...byDate.keys()].sort();

// Slates embedded for the client to choose "today" in ET: the build day and the
// next week, plus the last few dates before it for "last night".
const slateDates = dates.filter((d) => d >= buildDay).slice(0, 8);
const prevDates = dates.filter((d) => d < buildDay).slice(-3);
const defaultDate = slateDates[0] ?? null;
const defaultPrev = prevDates.at(-1) ?? null;
const slateInfo = (d) => {
  const list = byDate.get(d);
  const fc = list.filter((g) => g.fc).length;
  const graded = list.filter((g) => g.fc && g.status === "final");
  const right = graded.filter((g) => g.fc.correct).length;
  return { list, fc, graded: graded.length, right };
};
const dayLabel = (d) => new Date(d + "T12:00:00Z").toLocaleDateString("en-US", { timeZone: "UTC", weekday: "long", month: "short", day: "numeric" });

const bt = performance.record;
const cur = bt.seasons.find((s) => s.season === site.season);
const board = [
  { v: bt.all.n.toLocaleString(), l: "games graded" },
  { v: `${bt.all.win}%`, l: "winners picked" },
  ...(cur ? [{ v: `${cur.all.win}%`, l: `${site.season} winners picked` }] : []),
];
// Data status: when the data was exported and which injury report it used.
const slateGames = defaultDate ? byDate.get(defaultDate) : [];
const reportUsed = slateGames.map((g) => g.injuries?.report).filter(Boolean).sort().pop() ?? null;
const status = [
  ["Injury report", reportUsed ? reportUsed.replace(/^(\d{4}-\d{2}-\d{2}) (\d{2}):(\d{2}) ET$/, (m, d, hh, mm) => `${fmtShortDate(d)}, ${((+hh + 11) % 12) + 1}:${mm} ${+hh >= 12 ? "PM" : "AM"} ET`) : "none yet"],
];
---
<Base title={TITLE} description="The Hoop Ledger: NBA game forecasts with projected scores and win probabilities for every game, each one graded against the final result, every season since 2022-23." section="home">
  <div class="wrap">
    <section class="opening">
      <div class="hero-text">
        <p class="kicker accent">NBA forecasts, on the record</p>
        <h1><span class="l1">Every game forecast.</span> <span class="l2">Every forecast graded.</span></h1>
        <div class="hero-board"><Scoreboard cells={board} /></div>
        <p class="lede">An independent NBA model that forecasts every game and grades every forecast against the final score.</p>
        <p class="hero-links"><a class="btn primary" href="/forecasts/">Today's forecasts</a> <a class="btn" href="/performance/">See the record</a></p>
      </div>
      <DataBall />
    </section>

    <section class="section games" aria-labelledby="h-today">
      <div class="section-head">
        <h2 id="h-today">Games</h2>
        <a href="/forecasts/">All dates and filters</a>
      </div>
      <p class="statusline" aria-label="Data status">
        <span><span class="k">Updated</span> <span class="age" data-ts={site.generated_at}>{fmtDateTime(site.generated_at)}</span></span>
        {status.map(([k, v]) => <span><span class="k">{k}</span> <span class="num">{v}</span></span>)}
        <a href="/methodology/" title="Forecasts may be updated in the hour before tip-off with the latest injury report; the last one saved before tip-off is graded.">How forecasts are locked</a>
      </p>
      <div id="stale" class="state warn" hidden></div>
      {slateDates.length === 0 && <p class="state">No upcoming games are in this edition of the data. See the <a href="/forecasts/">forecast calendar</a>.</p>}
      <div class="slates">
        {[...prevDates.map((d) => ["prev", d]), ...slateDates.map((d) => ["next", d])].map(([kind, d]) => {
          const x = slateInfo(d);
          const show = d === (kind === "prev" ? defaultPrev : defaultDate);
          return (
            <div class={`slate ${kind}`} data-kind={kind} data-date={d} data-fc={x.fc} hidden={!show} style={kind === "prev" && defaultDate && slateInfo(defaultDate).fc === 0 ? "order:0" : "order:1"}>
              <div class="slate-head">
                <h3><span class="rel">{kind === "prev" ? "Last night" : "Tonight"}</span> <span class="day">{dayLabel(d)}</span></h3>
                <p class="meta">
                  {kind === "prev"
                    ? (x.graded ? <><b class="num">{x.right}–{x.graded - x.right}</b> picks · {x.list.length} games</> : `${x.list.length} games · results pending`)
                    : `${x.list.length} games · times ET · ${x.fc ? `${x.fc} forecast${x.fc > 1 ? "s" : ""} published` : "forecasts not yet published"}`}
                </p>
              </div>
              <SlateBoard games={x.list} label={`Games on ${d}`} />
            </div>
          );
        })}
      </div>
    </section>

    <WeekSurprise />
  </div>
</Base>

<script>
  // Relative age for the status bar ("3 h ago"), with a green dot under a day old
  // and an orange one past two days. Computed in the browser, so it stays honest
  // however long ago the site was built.
  const now = Date.now();
  for (const el of document.querySelectorAll(".age[data-ts]")) {
    const t = Date.parse(el.dataset.ts.replace(" ", "T"));
    if (Number.isNaN(t)) continue;
    const h = (now - t) / 3.6e6;
    if (h < 0) continue;
    el.textContent = h < 1 ? `${Math.max(1, Math.round(h * 60))} min ago` : h < 48 ? `${Math.round(h)} h ago` : `${Math.round(h / 24)} days ago`;
    el.classList.add(h < 24 ? "fresh" : h > 48 ? "stale" : "ok");
  }
</script>

<script define:vars={{ generated: site.generated_at }}>
  // Pick the slates in US Eastern time: the next date with games ("Tonight" when
  // it is today) and the most recent date before today ("Last night" when it was
  // yesterday). Until tonight's forecasts are published, last night comes first.
  const tz = "America/New_York";
  const ymd = (dt) => {
    const p = new Intl.DateTimeFormat("en-CA", { timeZone: tz, year: "numeric", month: "2-digit", day: "2-digit" }).formatToParts(dt);
    return `${p.find((x) => x.type === "year").value}-${p.find((x) => x.type === "month").value}-${p.find((x) => x.type === "day").value}`;
  };
  const today = ymd(new Date());
  const yesterday = ymd(new Date(Date.now() - 864e5));
  const slates = [...document.querySelectorAll(".slate")];
  const next = slates.find((el) => el.dataset.date >= today);
  const prev = slates.filter((el) => el.dataset.date < today).pop();
  slates.forEach((el) => { el.hidden = el !== next && el !== prev; });
  if (next) {
    next.querySelector(".rel").textContent = next.dataset.date === today ? "Tonight" : "Next games";
    next.style.order = "1";
  }
  if (prev) {
    prev.querySelector(".rel").textContent = prev.dataset.date === yesterday ? "Last night" : "Last games";
    prev.style.order = next && next.dataset.fc === "0" ? "0" : "2";
  }
  const hours = (Date.now() - Date.parse(generated)) / 3.6e6;
  const stale = document.getElementById("stale");
  if (stale && (hours > 30 || !next)) {
    const when = new Date(generated).toLocaleString("en-US", { timeZone: tz, month: "short", day: "numeric", hour: "numeric", minute: "2-digit" });
    stale.textContent = `This edition of the data was exported ${when} ET. Newer forecasts and results may exist but are not shown here.`;
    stale.hidden = false;
  }
</script>

<style>
  .statusline { display: flex; flex-wrap: wrap; gap: 4px 18px; font-size: 0.8rem; color: var(--ink-2); margin: calc(-1 * var(--s3)) 0 var(--s5); }
  .statusline .k { color: var(--muted); }
  .statusline .num { font-size: 0.78rem; }
  .slates { display: flex; flex-direction: column; gap: var(--s6); }
  .slate-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 4px var(--s4); margin-bottom: var(--s3); padding-bottom: 6px; border-bottom: 2px solid var(--rule-heavy); }
  .slate-head h3 { font-size: 1.05rem; }
  .slate-head .rel { color: var(--accent); text-transform: uppercase; letter-spacing: 0.08em; font-size: 0.78rem; margin-right: 6px; }
  .slate-head .meta { margin: 0; }
  .slate-head .meta b { color: var(--ink); }
  .age { white-space: nowrap; }
  .age::before { content: ""; display: inline-block; width: 7px; height: 7px; border-radius: 50%; margin-right: 6px; background: var(--neutral-mark); vertical-align: 0; }
  .age.fresh::before { background: var(--model); box-shadow: 0 0 0 0 var(--model); animation: ping 2.4s ease-out infinite; }
  .age.stale::before { background: var(--accent); }
  @keyframes ping { 0% { box-shadow: 0 0 0 0 rgba(94, 196, 176, 0.6); } 70%, 100% { box-shadow: 0 0 0 7px rgba(94, 196, 176, 0); } }
  .opening { padding-block: var(--s6) var(--s6); display: grid; gap: var(--s6); align-items: center; }
  @media (min-width: 900px) { .opening { grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); } }
  .hero-text { max-width: 640px; }
  /* Headline record sits right under the h1, beside the ball, so it shows on load. */
  .hero-board { margin: 0 0 var(--s4); }
  .hero-board :global(.board) { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .hero-board :global(.cell) { padding: 14px 8px 12px; }
  .hero-board :global(.digits) { font-size: clamp(1.25rem, 5vw, 2rem); }
  .hero-board :global(.lab) { font-size: 0.66rem; letter-spacing: 0.08em; }
  .hero-links { margin-top: var(--s5); display: flex; gap: var(--s3); flex-wrap: wrap; }
  .hero-links .btn { text-decoration: none; display: inline-flex; align-items: center; }
  .hero-links .btn.primary { background: var(--ink); color: var(--paper); border-color: var(--ink); }
  .hero-links .btn.primary:hover { background: var(--accent); border-color: var(--accent); }
  :global(.board) { margin-bottom: var(--s6); }
  .opening h1 .l1, .opening h1 .l2 { display: block; }
  .opening h1 .l2 { color: var(--accent); }
  .opening h1 { margin: var(--s3) 0 var(--s4); font-size: clamp(2rem, 4.6vw, 3rem); }
  .meta { font-size: 0.875rem; color: var(--muted); margin-bottom: var(--s3); }
  .sub { margin-bottom: var(--s3); }
</style>
