---
import Base from "../layouts/Base.astro";
---
<Base title="Page not found" description="The page you were looking for does not exist.">
  <div class="wrap">
    <header class="page-head read">
      <p class="kicker">404</p>
      <h1>Page not found</h1>
      <p class="lede">That page does not exist. Games that are not in this edition of the data have no page yet.</p>
      <p><a href="/forecasts/">Forecasts</a> · <a href="/forecasts/archive/">Archive</a> · <a href="/teams/">Teams</a></p>
    </header>
  </div>
</Base>
