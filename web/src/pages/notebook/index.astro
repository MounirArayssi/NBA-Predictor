---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import { fmtLongDate } from "../../lib/data.js";
const entries = (await getCollection("notebook")).sort((a, b) => +b.data.date - +a.data.date || a.data.title.localeCompare(b.data.title));
const topics = [...new Set(entries.map((e) => e.data.topic))].sort();
const tally = ["Kept", "Rejected", "Open"].map((o) => [o, entries.filter((e) => e.data.outcome === o).length]).filter(([, n]) => n);
---
<Base title="Notebook" description="Research notes from building the NBA forecast model: experiments that worked, ideas that did not, and open questions." section="notebook">
  <div class="wrap">
    <header class="page-head read">
      <p class="kicker accent">Research notes</p>
      <h1>Notebook</h1>
      <p class="lede">A working log of changes to the model and the questions behind them, including the ideas that were tested and dropped.</p>
    </header>

    <div class="bar">
      <p class="tally">{entries.length} entries{tally.map(([o, n]) => <span class={`o-${o.toLowerCase()}`}><b class="num">{n}</b> {o.toLowerCase()}</span>)}</p>
      <nav class="chips" aria-label="Filter by topic">
        <a href="/notebook/" data-topic="" aria-current="true">All</a>
        {topics.map((t) => <a href={`/notebook/?topic=${encodeURIComponent(t)}`} data-topic={t}>{t}</a>)}
      </nav>
    </div>

    <ol class="entries">
      {entries.map((e) => {
        const d = e.data.date.toISOString().slice(0, 10);
        return (
          <li data-topic={e.data.topic}>
            <div class="meta">
              <time datetime={d}>{fmtLongDate(d)}</time>
              <span>{e.data.topic}</span>
              <span class={`outcome o-${e.data.outcome.toLowerCase()}`}>{e.data.outcome}</span>
            </div>
            <div>
              <h2><a href={`/notebook/${e.id}/`}>{e.data.title}</a></h2>
              <p>{e.data.summary}</p>
            </div>
          </li>
        );
      })}
    </ol>
  </div>
</Base>

<script>
  const chips = [...document.querySelectorAll<HTMLAnchorElement>(".chips a")];
  const items = [...document.querySelectorAll<HTMLElement>(".entries li")];
  const apply = (topic: string) => {
    items.forEach((li) => (li.hidden = !!topic && li.dataset.topic !== topic));
    chips.forEach((c) => (c.dataset.topic === topic ? c.setAttribute("aria-current", "true") : c.removeAttribute("aria-current")));
  };
  chips.forEach((c) => c.addEventListener("click", (e) => {
    e.preventDefault();
    const t = c.dataset.topic || "";
    const u = new URL(location.href);
    t ? u.searchParams.set("topic", t) : u.searchParams.delete("topic");
    history.replaceState(null, "", u);
    apply(t);
  }));
  apply(new URLSearchParams(location.search).get("topic") || "");
</script>

<style>
  .bar { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: var(--s3) var(--s5); max-width: 980px; margin-bottom: var(--s4); }
  .tally { margin: 0; font-size: 0.9rem; color: var(--muted); display: flex; flex-wrap: wrap; gap: 4px var(--s4); }
  .tally span { font-weight: 600; }
  .chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .chips a { font-size: 0.85rem; padding: 4px 12px; border: 1px solid var(--rule); border-radius: 999px; color: var(--ink-2); text-decoration: none; }
  .chips a:hover { border-color: var(--ink-2); }
  .chips a[aria-current] { background: var(--ink); border-color: var(--ink); color: var(--paper, #fff); }
  .entries { list-style: none; margin: 0; padding: 0; border-top: 2px solid var(--rule-heavy); max-width: 980px; }
  .entries li { display: grid; gap: var(--s2) var(--s6); padding: var(--s5) 0; border-bottom: 1px solid var(--rule); }
  @media (min-width: 760px) { .entries li { grid-template-columns: 200px minmax(0, 1fr); } }
  .meta { display: flex; flex-direction: column; gap: 2px; font-size: 0.85rem; color: var(--muted); }
  .meta time { color: var(--ink-2); font-weight: 500; }
  .outcome { font-size: 0.72rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; }
  .o-kept { color: var(--model); }
  .o-rejected { color: var(--accent); }
  .o-open, .o-note { color: var(--muted); }
  h2 { font-size: 1.35rem; margin-bottom: var(--s2); }
  h2 a { color: var(--ink); text-decoration: none; }
  h2 a:hover { text-decoration: underline; }
  .entries p { color: var(--ink-2); margin: 0; max-width: 68ch; }
</style>
